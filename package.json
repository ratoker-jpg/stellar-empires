{
  "name": "stellar-empires",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "assets:audit": "node scripts/assets/audit.mjs",
    "assets:check": "node scripts/assets/check.mjs",
    "assets:process": "node scripts/assets/process.mjs",
    "assets:atlas": "node scripts/assets/atlas.mjs",
    "check": "npm run assets:check && npm run lint && npm run typecheck && npm run test && vite build",
    "assets:contact-sheet": "node scripts/assets/contact-sheet.mjs",
    "e2e": "playwright test",
    "e2e:production": "playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.0",
    "eslint": "10.6.0",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
